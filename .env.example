# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Loaded at startup by DotNetEnv (see Program.cs). Keys use the ASP.NET Core
# "__" convention to map onto nested config (ConnectionStrings:DefaultConnection,
# Jwt:Key, ...).

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pos_db;Username=postgres;Password=your-postgres-password

# Used by docker compose: password for the bundled `db` postgres service and
# interpolated into the server container's connection string (Host=db).
POSTGRES_PASSWORD=your-postgres-password

# Must be at least 32 characters (HMAC-SHA256 signing key).
Jwt__Key=replace-with-a-long-random-secret-min-32-chars
Jwt__Issuer=POSApp
Jwt__Audience=POSApp

# Comma-separated list of browser origins allowed to call the API (CORS).
# Defaults to http://localhost:5173 when unset.
#
# http://localhost:5173  is the Vite dev server (npm run dev).
# http://localhost       is IIS serving the built web admin on the on-premise PC.
#
# The API listens on 5103 and IIS serves the SPA on a different port, so the two
# are separate origins and the browser enforces CORS between them. An origin that
# is missing here fails every API call with a CORS error visible only in the
# browser console — the UI just looks broken. Include the IIS port if it is not
# 80, e.g. http://localhost:8080
Cors__AllowedOrigins=http://localhost:5173,http://localhost
